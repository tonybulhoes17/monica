# Supabase - crie um projeto em https://supabase.com e preencha com os valores
# encontrados em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - NUNCA expor no client. Usada apenas em rotas server-side
# (ex: criar contas de secretárias, assinar laudos).
SUPABASE_SERVICE_ROLE_KEY=

# Nome e CRM exibidos no cabeçalho/carimbo do laudo (provisório, até o
# carimbo final e a logo serem enviados).
NEXT_PUBLIC_CLINIC_NAME="Dra. Monica Seixas"
NEXT_PUBLIC_DOCTOR_CRM="CRMBA 28539 RQE 19407"

# Origem pública do app (sem barra no final) - usada para montar o
# redirect_uri exato do OAuth do Vidas. Em produção:
# https://laudos-eeg-monica.vercel.app
APP_BASE_URL=

# Vidas / VIDaaS (Certificado em Nuvem, Valid) - assinatura digital real.
# Enquanto as 3 variáveis abaixo não estiverem todas preenchidas, o sistema
# usa um modo simulado (ver src/lib/signing/vidas.ts) - sem validade jurídica,
# só para testar o resto do fluxo.
#
# VIDAAS_CLIENT_ID / VIDAAS_CLIENT_SECRET: credenciais da aplicação
# registrada junto à Valid (POST /v0/oauth/application - ver
# scripts/vidas-register-application.mjs para registrar uma nova).
VIDAAS_CLIENT_ID=
VIDAAS_CLIENT_SECRET=

# Default: produção (https://certificado.vidaas.com.br). Homologação é
# instável segundo o guia de integração - só trocar se a Valid orientar.
VIDAAS_BASE_URL=

# Chave simétrica (32 bytes em hex) para criptografar o access_token do
# Vidas em repouso no banco. Gerar com: openssl rand -hex 32
VIDAAS_SESSION_ENCRYPTION_KEY=

# Duração da sessão de assinatura em segundos (padrão 12h = 43200) - dentro
# desse prazo, assinar não pede escanear o QR code de novo.
VIDAAS_SESSION_LIFETIME_SECONDS=43200
